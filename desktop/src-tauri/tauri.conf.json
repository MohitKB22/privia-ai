{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://127.0.0.1:5173",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": { "productName": "PRIVIA", "version": "1.0.0" },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": { "all": false, "open": true, "save": false },
      "shell": { "all": false, "open": false, "execute": false, "sidecar": false },
      "fs": { "all": false },
      "http": { "all": false },
      "process": { "all": false }
    },
    "bundle": {
      "active": true,
      "targets": ["app", "dmg", "deb", "appimage", "msi"],
      "identifier": "app.privia.desktop",
      "category": "Productivity",
      "shortDescription": "Private Personal AI",
      "longDescription": "A local-first personal assistant. Runs on your machine, asks before it acts.",
      "copyright": "Apache-2.0",
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
      "resources": [],
      "macOS": { "minimumSystemVersion": "11.0" },
      "windows": { "certificateThumbprint": null, "digestAlgorithm": "sha256" }
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8756 http://localhost:8756; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src 'self' blob: data:",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true
    },
    "updater": { "active": false },
    "windows": [
      {
        "title": "PRIVIA",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ]
  }
}
